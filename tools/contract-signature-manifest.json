  "non_normative_blocks": [
    {
      "text": "        commission_rate=0.0003,\n        slippage=0.002",
      "why": "§2.9 示例用 commission_rate / slippage 构造 BacktestConfig —— 这两个字段不存在，规范字段是 commission_config / slippage_config（§2.1.2）"
    },
    {
      "text": "        file_path=\"./data/historical_prices.csv\",\n        date_col=\"trade_date\",\n        symbol_col=\"ticker\"",
      "why": "§2.9 示例用 file_path / date_col / symbol_col 构造 CsvDataFeed —— 规范签名是 CsvDataFeed(csv_path: str)"
    },
    {
      "text": "    engine = BacktestEngine(config=config, data_feed=data_feed)",
      "why": "§2.9 示例给 BacktestEngine 传 data_feed —— 规范构造器只有 config，数据源由 add_datafeed(symbol, datafeed) 挂上去"
    },
    {
      "text": "    engine.register_strategy(strategy)",
      "why": "§2.9 示例调 register_strategy —— 规范方法是 add_strategy(strategy, capital, params)"
    },
    {
      "text": "    performance = backtest_result.get_performance()",
      "why": "§2.9 示例把 performance 当方法 —— BacktestResult.performance 是 @dataclass 字段"
    },
    {
      "text": "from backtest_engine import (",
      "why": "§2.9 示例从 backtest_engine 导入 —— 实现包名是 quanauto"
    }
  ],
  "note": "契约侧与实现侧的签名清单。两边都记下来，是为了让「有人单边改了签名」这件事一定能被 verify_contract_signature.py 看见；两边不一致而又没在 divergences / not_implemented / extras 里登记过的，一律 FAIL。契约侧签名必须能在契约文档里逐字找到（S1），所以这份清单是抄写，不是发明。",
  "schema": "quanauto.contract-signature-manifest/1"
